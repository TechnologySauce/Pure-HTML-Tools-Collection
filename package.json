{
  "name": "pure-html-tools",
  "version": "1.0.0",
  "private": true,
  "description": "单文件、零依赖、离线可用的纯 HTML 工具合集",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "validate": "html-validate \"index.html\" \"404.html\" \"tools/*.html\"",
    "test": "node scripts/test.mjs",
    "check": "npm run build && npm run validate && npm test"
  },
  "devDependencies": {
    "html-validate": "^11.17.0",
    "jsdom": "^29.1.1"
  },
  "license": "MIT"
}
